{
  "name": "conjuletter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "import:english": "python src/scratch/import_english_questions.py",
    "import:english-preview": "python src/scratch/import_english_preview.py",
    "audit:english": "python src/scratch/audit_english_question_bank.py",
    "audit:english-preview": "python src/scratch/audit_english_preview.py",
    "audit:english-corpora": "python src/scratch/audit_english_corpora.py",
    "audit:questions": "python src/scratch/audit_question_bank.py",
    "audit:question-report": "python src/scratch/generate_question_audit_report.py",
    "audit:verbs": "node scripts/audit-verbs.cjs",
    "audit:normalized": "tsx scripts/audit-normalized-questions.ts",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle-budget.cjs",
    "check": "npm run lint && npm run test:coverage && npm run audit:verbs && npm run audit:questions && npm run audit:english && npm run audit:english-preview && npm run audit:english-corpora && npm run audit:normalized && npm run build && npm run check:bundle",
    "preview": "vite preview",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.35.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
