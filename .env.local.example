# Copie este arquivo para .env.local e preencha no servidor local.
# Nunca use o prefixo VITE_ nestas variáveis: a chave não pode chegar ao navegador.
OPENROUTER_API_KEY=sk-or-v1-cole-sua-chave-aqui
OPENROUTER_MODEL=google/gemini-3.7-flash
# Origem pública exata aceita pela API (sem barra final).
PUBLIC_ORIGIN=http://localhost:4173
